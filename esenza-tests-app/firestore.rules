rules_version = '2';

// Solo tu cuenta autenticada (la que crees en Firebase Auth) puede leer o
// escribir datos. Como el login en la app no tiene registro público, la
// única forma de autenticarse es con el usuario/contraseña que tú crees
// manualmente en Firebase Console → Authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
